settings set auto-confirm true
breakpoint set -n NSApplicationMain -G 1 -C "bt 1"
breakpoint set -n SLSMainConnectionID -G 1 -C "bt 1"
breakpoint set -n SLSServerPort -G 1 -C "bt 1"
breakpoint set -n SLSNewConnection -G 1 -C "bt 1"
breakpoint set -n SLPSRegisterWithServer -G 1 -C "bt 1"
breakpoint set -n SLPSGetCurrentProcess -G 1 -C "bt 1"
breakpoint set -n SLPSSetMainApplicationConnection -G 1 -C "bt 1"
breakpoint set -n SLSGetEventPort -G 1 -C "bt 1"
breakpoint set -n SLSGetNextEventRecord -G 1 -C "bt 1"
breakpoint set -n SLSNewWindow -G 1 -C "bt 1"
breakpoint set -n SLSOrderWindow -G 1 -C "bt 1"
breakpoint set -n SLSSetWindowTitle -G 1 -C "bt 1"
breakpoint set -n SLSSetWindowLayerContext -G 1 -C "bt 1"
breakpoint set -n SLSTransactionCreate -G 1 -C "bt 1"
breakpoint set -n SLSTransactionCommit -G 1 -C "bt 1"
breakpoint set -n SLSTransactionCommitUsingMethod -G 1 -C "bt 1"
breakpoint set -n SLSTransactionSetWindowShape -G 1 -C "bt 1"
breakpoint set -n SLSTransactionSetWindowLevel -G 1 -C "bt 1"
breakpoint set -n SLSTransactionOrderWindow -G 1 -C "bt 1"
breakpoint set -n SLSDisplaySystemStateSeed -G 1 -C "bt 1"
breakpoint set -n CGWindowContextCreate -G 1 -C "bt 1"
breakpoint set -n CGBitmapContextCreate -G 1 -C "bt 2" -C "register read x1 x2"
breakpoint set -n CARenderServerGetServerPort -G 1 -C "bt 1"
breakpoint set -n CARenderServerStart -G 1 -C "bt 1"
breakpoint set -n CACFContextCreate -G 1 -C "bt 1"
breakpoint set -n CALayerGetContext -G 1 -C "bt 1"
breakpoint set -n "+[CAContext remoteContext]" -G 1 -C "bt 1"
breakpoint set -n "+[CAContext remoteContextWithOptions:]" -G 1 -C "bt 1"
breakpoint set -n "-[CAContext setLayer:]" -G 1 -C "bt 1"
breakpoint set -n "+[CATransaction commit]" -G 1 -C "bt 1"
breakpoint set -n "+[CATransaction flush]" -G 1 -C "bt 1"
breakpoint set -n "-[NSApplication nextEventMatchingMask:untilDate:inMode:dequeue:]" -G 1 -C "bt 1"
breakpoint set -n "CA::Render::Message::send_message" -G 1 -C "bt 1"
run
