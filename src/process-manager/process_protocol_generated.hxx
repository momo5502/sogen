      return verifier.VerifyTable(ptr);
    }
    case MessagePayload_AllocateMemoryRequest: {
      auto ptr = reinterpret_cast<const ProcessProtocol::AllocateMemoryRequest *>(obj);
      return verifier.VerifyTable(ptr);
    }
    case MessagePayload_FreeMemoryRequest: {
      auto ptr = reinterpret_cast<const ProcessProtocol::FreeMemoryRequest *>(obj);
