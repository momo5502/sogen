    }
    case MessagePayload_WriteMemoryRequest: {
      auto ptr = reinterpret_cast<const ProcessProtocol::WriteMemoryRequest *>(obj);
      return verifier.VerifyTable(ptr);
    }
    case MessagePayload_ProcessMemoryResponse: {
      auto ptr = reinterpret_cast<const ProcessProtocol::ProcessMemoryResponse *>(obj);
      return verifier.VerifyTable(ptr);
    }
    case MessagePayload_ProcessErrorResponse: {
      auto ptr = reinterpret_cast<const ProcessProtocol::ProcessErrorResponse *>(obj);
      return verifier.VerifyTable(ptr);
    }
