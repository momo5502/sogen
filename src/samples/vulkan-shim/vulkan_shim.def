    vkCmdBindIndexBuffer2KHR
    vkCmdBindPipeline
    vkCmdBeginDebugUtilsLabelEXT
    vkCmdBindVertexBuffers
    vkCmdBindVertexBuffers2
    vkCmdBindTransformFeedbackBuffersEXT
