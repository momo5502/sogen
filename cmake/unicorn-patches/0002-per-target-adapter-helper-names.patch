diff --git a/qemu/include/exec/helper-head.h b/qemu/include/exec/helper-head.h
index 9d7add4..33bc302 100644
--- a/qemu/include/exec/helper-head.h
+++ b/qemu/include/exec/helper-head.h
@@ -20,6 +20,19 @@
 
 #define HELPER(name) glue(helper_, name)
 
+/* Unicorn: an adapter thunk's body calls HELPER(name), which the -include'd
+   <arch>.h remaps to a target-suffixed symbol, so the thunks are per-target
+   even though their generated name was not. Every target therefore emitted a
+   same-named thunk with a different body; the linker silently kept one and
+   both targets called through it. Postfix the thunk too, the way memory.h
+   already postfixes address_space_*. */
+#ifdef UNICORN_ARCH_POSTFIX
+#define ADAPTER_HELPER(name)                                                   \
+    glue(glue(adapter_helper_, name), UNICORN_ARCH_POSTFIX)
+#else
+#define ADAPTER_HELPER(name) glue(adapter_helper_, name)
+#endif
+
 /* Some types that make sense in C, but not for TCG.  */
 #define dh_alias_i32 i32
 #define dh_alias_s32 i32
