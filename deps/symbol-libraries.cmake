function(sogen_add_symbol_curl)
  set(BUILD_CURL_EXE OFF CACHE BOOL "" FORCE)
  set(BUILD_SHARED_LIBS OFF)
  set(BUILD_STATIC_LIBS ON)
  set(BUILD_TESTING OFF)
  set(BUILD_LIBCURL_DOCS OFF)
  set(BUILD_MISC_DOCS OFF)
  set(CURL_DISABLE_INSTALL ON)
  set(CURL_ENABLE_EXPORT_TARGET OFF)
  foreach(protocol DICT FILE FTP GOPHER IMAP LDAP LDAPS MQTT POP3 RTSP SMTP TELNET TFTP IPFS WEBSOCKETS)
    set(CURL_DISABLE_${protocol} ON)
  endforeach()
  set(CURL_USE_LIBPSL OFF)
  set(CURL_USE_LIBSSH2 OFF)
  set(CURL_USE_LIBSSH OFF)
  set(CURL_USE_GSSAPI OFF)
  set(USE_NGHTTP2 OFF)
  set(USE_LIBIDN2 OFF)
  set(CURL_ZLIB OFF CACHE STRING "" FORCE)
  set(CURL_BROTLI OFF CACHE STRING "" FORCE)
  set(CURL_ZSTD OFF CACHE STRING "" FORCE)
  set(CURL_USE_OPENSSL OFF)
  if(WIN32)
    set(CURL_USE_SCHANNEL ON)
  else()
    set(CURL_USE_MBEDTLS ON)
    set(HAVE_MBEDTLS_DES_CRYPT_ECB ON)
    set(MBEDTLS_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/mbedtls/include")
    set(MBEDTLS_LIBRARY sogen_mbedtls)
    set(MBEDX509_LIBRARY sogen_mbedx509)
    set(MBEDCRYPTO_LIBRARY sogen_mbedcrypto)
  endif()
  add_subdirectory(curl EXCLUDE_FROM_ALL SYSTEM)
endfunction()

if(NOT EMSCRIPTEN)
  sogen_add_symbol_curl()
endif()
